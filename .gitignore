# Ignore everything by default
*

# But allow Git to traverse directories
!*/

# Track Jupyter notebooks
!*.ipynb
!*.R
!*.py
!*.md
!*.toml
!LICENSE*
!README*
!env/*.yml
!env/*.lock
!env/*.txt
!env/*.sh
!.github/**
!.github/workflows/*.yml
!jobs/*.slurm
!r/chronopackR/DESCRIPTION
!src/**
!tests/**

__pycache__/
*.py[cod]
.conda_home/
.conda_pkgs*/
.envs/

# Track this ignore file itself
!.gitignore

# Don't track Jupyter checkpoint notebooks
.ipynb_checkpoints/
k562-tnfa-puromycin.hg38/DimensionalityReductionClustering.Old.ipynb
k562-tnfa-puromycin.hg38/reference/DimensionalityReductionClustering.Old.ipynb
