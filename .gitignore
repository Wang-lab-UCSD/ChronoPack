# Ignore everything by default
*

# But allow Git to traverse directories
!*/

# Track Jupyter notebooks
!*.ipynb
!*.R
!*.py
!*.md
!*.toml
!LICENSE*
!README*
!env/*.yml
!env/*.lock
!env/*.txt
!env/*.sh
!.github/**
!.github/workflows/*.yml
!jobs/*.slurm
!r/chronopackR/DESCRIPTION
!src/**
!tests/**
# Small inputs read by the analyses/ notebooks
!analyses/resources/*
!analyses/resources/omnipath_snapshot_*/*
!analyses/k562-tnfa.hg38.rep/exclude_leiden_clusters.manuscript.csv

__pycache__/
*.py[cod]
.conda_home/
.conda_pkgs*/
.envs/

# Track this ignore file itself
!.gitignore

# Don't track Jupyter checkpoint notebooks
.ipynb_checkpoints/

# Analysis data (CHRONOPACK_DATA_DIR default) and verification run records
analyses/data/
# Raw experiment inputs (time-tagged DGE tables, negative-control pseudobulk); not in git
analyses/inputs/
verification_runs/
.github/workflows/ci.yml
